{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "context": "Server=.;Database=CleanArchitecture;Trusted_Connection=True;TrustServerCertificate=True;"
  },
  "Jwt": {
    "Issuer": "CleanArchitecture.Api",
    "Audience": "CleanArchitecture.Client",
    "ExpirationInMinutes": 30
  },
  "RefreshToken": {
    "ExpirationInDays": 30
  }
}
